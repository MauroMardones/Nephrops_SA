file_name <- tools::file_path_sans_ext(basename(f))
# Crear un título de sección o caption limpio
clean_title <- gsub("_", " ", file_name)
# Imprimir el encabezado y la imagen
cat(paste0("\n\n#### Results for ", clean_title, "\n"))
# Generar el chunk de la imagen dinámicamente
print(knitr::include_graphics(f))
}
